work/
out/
data/
.venv/
.venv-align/
# composed on the server by tools/compose_music.py (deterministic, ~19 MB): not in git
assets/music/*.m4a
assets/music/*.wav
# synthesized by tools/compose_sfx.py (deterministic, composed on first use): not in git
assets/sfx/*.wav
remotion/node_modules
compose/node_modules
__pycache__/
*.pyc
.pytest_cache/
# secrets never go in git (the repo is public): keys live only in data/.env on the server
.env
.env.*
.dev.vars
*.pem
*.key
# a composed film's source holds only the agent's files; tools/compose_scaffold.py builds it per pack under out/
compose/*/.hyperframes/
