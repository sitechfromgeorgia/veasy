# tbilisi.today Shorts server settings: copied to data/.env (chmod 600) by install.sh.
# Values live only on the server. Never commit a filled copy.
GEMINI_API_KEY=
# plain | anchor | firm | clear | warm | documentary | family (a tone per category family)
SHORTS_VOICE=family
# auto (by category: hard news editorial, light news kinetic, service news cards) | editorial | kinetic | cards
SHORTS_VARIANT=auto
SHORTS_MONTHLY_LIMIT_USD=10
SHORTS_DATA=/root/.hermes/shared-plugins/veasy/data
ALIGN_PYTHON=/root/.hermes/shared-plugins/veasy/.venv-align/bin/python
# phase 1: SHORTS_FEED_TOKEN (same value as the tt-web secret), TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# phase 2: YOUTUBE_*, META_*, TIKTOK_* platform credentials
# Georgian gate: kaeasy (github.com/sitechfromgeorgia/kaeasy), the plugin every agent on this server uses
KAEASY_DIR=/root/.hermes/shared-plugins/kaeasy
# one shared mistakes memory for the whole fleet (the videos' editor fixes go there too)
KAEASY_DATA_DIR=/root/.hermes/shared-knowledge/kaeasy
# refuse to render without the Georgian gate
SHORTS_REQUIRE_KAEASY=1
# the automatic writer draws a picture of each story (art.py checks it; a failing one is dropped)
# VEASY_WRITER_DRAW=0 turns it off
