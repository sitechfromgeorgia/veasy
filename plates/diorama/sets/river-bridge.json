  "name": "The Stone Arch River Crossing",
  "description": "Panoramic river landscape featuring a monumental three-span stone arch bridge crossing a stepped contour paper riverbed, layered masonry embankment steps, silhouette riverside trees, and four receding tiers of paper-cut hills fading into atmospheric valley mist.",
  "duration": 6.0,
  "tone": "greys-blacks-paper-whites",
  "environment": {
    "background_color": "#060606",
    "fog": {
      "type": "linear",
      "color": "#0c0c0b",
      "near": 6.5,
      "far": 24.0
    },
    "lighting": {
      "ambient": {
        "sky_tone": "#4a4a46",
        "ground_tone": "#141413",
        "intensity": 0.85
      },
      "key_light": {
        "type": "directional",
        "color": "#ffffff",
        "intensity": 2.7,
        "position": [-7.5, 5.5, 3.2],
        "target": [0.4, 0.35, -2.4],
        "description": "Low raking dawn sunlight grazing stepped paper water ripple edges and highlighting bridge voussoirs and balustrade crests."
      },
      "fill_light": {
        "type": "directional",
        "color": "#6c6c68",
        "intensity": 0.55,
        "position": [5.5, 3.8, 1.2],
        "target": [-0.3, 0.8, -1.0],
        "description": "Gentle riverside fill softening cutwater shadows and illuminating embankment masonry steps."
      }
    }
  },
  "camera": {
    "move": "wipe-cut",
    "duration": 6.0,
    "easing": "cubic-bezier(0.42, 0.0, 0.18, 1.0)",
    "path": {
      "start": {
        "position": [1.45, 1.62, 4.3],
        "target": [-0.25, 0.95, -3.2],
        "fov": 38.0
      },
      "end": {
        "position": [-0.32, 1.38, 1.55],
        "target": [0.12, 1.08, -4.8],
        "fov": 34.0
      }
    },
    "choreography_notes": "The shot opens tightly occluded behind a textured foreground stone abutment and drooping paper willow foliage on the right. A graceful lateral dolly-truck to the left wipes the foreground obstruction across the lens in seconds 0.0-1.8, executing a dramatic physical paper reveal-behind that unveils the expansive river valley, stone bridge crossing, and mist-veiled mountain tiers."
  },
