{
  "$schema": "./schema.json",
  "id": "street",
  "name": "The Layered Urban Streetscape",
  "description": "A deep perspective streetscape engineered with layered paper townhouse facades, cantilevered shopfront awnings, scored cobblestone roadway, silhouette streetlamps, cutout deciduous trees, and a distant vanishing point cross-vista.",
  "duration": 6.0,
  "tone": "greys-blacks-paper-whites",
  "environment": {
    "background_color": "#060606",
    "fog": {
      "type": "linear",
      "color": "#0a0a0a",
      "near": 6.5,
      "far": 20.0
    },
    "lighting": {
      "ambient": {
        "sky_tone": "#3c3c3a",
        "ground_tone": "#121212",
        "intensity": 0.8
      },
      "key_light": {
        "type": "directional",
        "color": "#ffffff",
        "intensity": 2.6,
        "position": [7.5, 6.5, 3.5],
        "target": [-0.8, 0.6, -2.5],
        "description": "Raking cross-street key light grazing cobblestone grooves and projecting long facade shadows across the pavement."
      },
      "fill_light": {
        "type": "directional",
        "color": "#6a6a66",
        "intensity": 0.6,
        "position": [-5.0, 4.0, 2.0],
        "target": [0.5, 1.0, -1.0],
        "description": "Gentle front-left fill revealing layered paper cutouts under store awnings and porch reveals."
      }
    }
  },
  "camera": {
    "move": "reveal-behind",
    "duration": 6.0,
    "easing": "cubic-bezier(0.4, 0.0, 0.2, 1.0)",
    "path": {
      "start": {
        "position": [-1.75, 1.55, 4.2],
        "target": [0.15, 1.15, -4.5],
        "fov": 37.0
      },
      "end": {
        "position": [-0.35, 1.3, 1.6],
        "target": [0.2, 1.25, -5.2],
        "fov": 33.0
      }
    },
    "choreography_notes": "The move opens partially masked behind a foreground paper streetlamp and leafy branch on the left flank. The camera tracks laterally right while pushing steadily forward, gliding past the foreground silhouette in an organic object-wipe that unmasks the deep cobblestone avenue and vibrant shop facades."
  },
  "depth_layers": {
    "foreground": {
      "z_range": [2.6, 5.0],
      "role": "Cut-paper tree trunk with hanging canopy branch, detailed streetlamp with multi-pane lantern cutout, and elevated sidewalk curb creating an intimate framing proscenium."
    },
    "midground": {
