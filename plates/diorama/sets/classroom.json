        "sky_tone": "#40403e",
        "ground_tone": "#151514",
        "intensity": 0.8
      },
      "key_light": {
        "type": "directional",
        "color": "#ffffff",
        "intensity": 2.9,
        "position": [-8.5, 7.8, 1.5],
        "target": [0.4, 0.8, -1.8],
        "description": "High-contrast morning window key light raking sharply across polished paper desk rims and the chalkboard facade."
      },
      "fill_light": {
        "type": "directional",
        "color": "#686864",
        "intensity": 0.5,
        "position": [6.0, 4.5, 2.0],
        "target": [-0.5, 1.1, -1.2],
        "description": "Subtle fill bouncing from the library bookshelf side, illuminating chalkboard slate crevices and desk risers."
      }
    }
  },
  "camera": {
    "move": "crane",
    "duration": 6.0,
