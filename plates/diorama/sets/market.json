{
  "$schema": "./schema.json",
  "id": "market",
  "name": "The Old Quarter Bazaar",
  "description": "Dense, vibrant open-air marketplace featuring draped paper canopy stalls, tiered display tables, stacked corrugated crates, banded wooden barrels, a central civic fountain, and receding layered stone market gate archways.",
  "duration": 6.0,
  "tone": "greys-blacks-paper-whites",
  "environment": {
    "background_color": "#070707",
    "fog": {
      "type": "linear",
      "color": "#0d0d0c",
      "near": 6.0,
      "far": 20.0
    },
    "lighting": {
      "ambient": {
        "sky_tone": "#464642",
        "ground_tone": "#181816",
        "intensity": 0.85
      },
      "key_light": {
        "type": "directional",
        "color": "#ffffff",
        "intensity": 2.7,
        "position": [-4.0, 8.5, 2.5],
        "target": [0.2, 0.6, -1.8],
        "description": "High-angle filtered sunlight piercing gaps between canvas stall canopies, casting sharp slatted shadows over crate stacks and pavement."
      },
      "fill_light": {
        "type": "directional",
        "color": "#6e6e6a",
        "intensity": 0.6,
        "position": [4.5, 4.5, 1.5],
        "target": [-0.2, 0.9, -1.0],
        "description": "Diffuse market alley fill illuminating barrel textures and merchandise counters."
      }
    }
  },
  "camera": {
    "move": "push-through",
    "duration": 6.0,
    "easing": "cubic-bezier(0.42, 0.0, 0.2, 1.0)",
    "path": {
      "start": {
        "position": [-0.65, 1.45, 4.8],
        "target": [0.1, 1.05, -3.2],
        "fov": 39.0
      },
      "end": {
        "position": [0.05, 1.18, 1.7],
        "target": [0.1, 1.08, -4.6],
        "fov": 34.0
      }
    },
    "choreography_notes": "The camera ducks beneath fluttering paper awning fringes in the foreground, sliding past a rustic pyramid of crates and barrels. The gliding push-through penetrates deep into the bazaar's main thoroughfare, revealing bustling vendor stands and framing the monumental layered stone archway."
  },
  "depth_layers": {
    "foreground": {
      "z_range": [2.8, 5.2],
      "role": "Overhanging scalloped canopy valance, rustic pyramid of corrugated paper crates, and banded barrel silhouettes forming an intimate market stall threshold."
    },
