{
 "type": "trend",
 "order": 130,
 "what": "3-8 values over time from the articles, a line that draws itself: items [{label, value}]",
 "use_when": "3-8 values over time from the articles",
 "avoid_when": "fewer than 3 points in time (change)",
 "pairs_with": ["change", "stat"],
 "slots": {
  "items": {"kind": "list", "count": [3, 8], "of": {"label": {"kind": "text", "max": 12, "required": true}, "value": {"kind": "num", "required": true}}, "required": true},
  "kicker": {"kind": "text", "max": 24},
  "headline": {"kind": "text", "max": 40},
  "unit": {"kind": "text", "max": 16},
  "label": {"kind": "text", "max": 48}
 },
 "families_deny": [],
 "min_seconds": 3.2,
 "min_words": 7,
 "em": {"fields": ["label", "headline"], "kinds": ["underline"]},
 "schema": {"type": "trend", "at": "...", "kicker": "...", "unit": "...", "items": [{"label": "2023", "value": 1.2}, {"label": "2024", "value": 1.4}, {"label": "2025", "value": 1.5}]},
 "rules": [
  "\"trend\": 3-8 values the article states, in time order, one unit, no computed differences;"
 ],
 "example": {"type": "trend", "at": "ბოლო სამ წელს", "kicker": "ტრენდი", "unit": "ლარი", "items": [{"label": "2023", "value": 1.2}, {"label": "2024", "value": 1.4}, {"label": "2025", "value": 1.5}]}
}
