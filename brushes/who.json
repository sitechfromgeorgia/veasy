{
 "type": "who",
 "order": 50,
 "what": "1-3 people or bodies: items [{name, role}]",
 "use_when": "1-3 people or bodies act in the story",
 "avoid_when": "the people meet each other (link) or are quoted (quote)",
 "pairs_with": ["quote", "link"],
 "slots": {
  "items": {"kind": "list", "count": [1, 3], "of": {"name": {"kind": "text", "max": 32, "required": true}, "role": {"kind": "text", "max": 40}}, "required": true},
  "kicker": {"kind": "text", "max": 24},
  "headline": {"kind": "text", "max": 40}
 },
 "families_deny": [],
 "min_seconds": 2.5,
 "min_words": 6,
 "em": {"fields": ["items.name", "headline"], "kinds": ["underline", "box"]},
 "schema": {"type": "who", "at": "...", "kicker": "...", "items": [{"name": "...", "role": "..."}]},
 "rules": [],
 "example": {"type": "who", "at": "შსს-ს ცნობით", "kicker": "ვინ", "items": [{"name": "შსს", "role": "გამოძიება"}]}
}
