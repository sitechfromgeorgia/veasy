{
 "type": "timeline",
 "order": 30,
 "what": "from-to times or dates stated in the articles",
 "use_when": "exact from-to times or dates the articles state (a cut, a closure, a deadline)",
 "avoid_when": "the articles give no exact time; several dated events (rail)",
 "pairs_with": ["where", "stat"],
 "slots": {
  "start": {"kind": "text", "max": 24, "required": true},
  "end": {"kind": "text", "max": 24, "required": true},
  "kicker": {"kind": "text", "max": 24},
  "headline": {"kind": "text", "max": 40},
  "big": {"kind": "text", "max": 24},
  "label": {"kind": "text", "max": 48}
 },
 "families_deny": [],
 "min_seconds": 2.5,
 "min_words": 6,
 "em": {"fields": ["label", "headline"], "kinds": ["underline", "box"]},
 "schema": {"type": "timeline", "at": "...", "kicker": "...", "headline": "...", "big": "22:00 -> 10:00", "start": "...", "end": "..."},
 "rules": [
  "do not use a \"timeline\" scene unless the article states exact times or dates for it;"
 ],
 "example": {"type": "timeline", "at": "გაზი არ იქნება", "kicker": "როდის", "big": "22:00 → 10:00", "start": "2 ნოემბერი, 22:00", "end": "3 ნოემბერი, 10:00", "label": "გაზის მიწოდება შეჩერდება"}
}
