{
 "type": "change",
 "order": 140,
 "what": "one value then and now from the articles: before {label, value}, after {label, value}",
 "use_when": "one value then and now",
 "avoid_when": "the two values are of different things (compare, bars)",
 "pairs_with": ["trend", "stat"],
 "slots": {
  "before": {"kind": "obj", "of": {"label": {"kind": "text", "max": 16, "required": true}, "value": {"kind": "num", "required": true}}, "required": true},
  "after": {"kind": "obj", "of": {"label": {"kind": "text", "max": 16, "required": true}, "value": {"kind": "num", "required": true}}, "required": true},
  "kicker": {"kind": "text", "max": 24},
  "headline": {"kind": "text", "max": 40},
  "unit": {"kind": "text", "max": 16},
  "label": {"kind": "text", "max": 48}
 },
 "families_deny": [],
 "min_seconds": 3.0,
 "min_words": 6,
 "em": {"fields": ["label", "headline"], "kinds": ["underline"]},
 "schema": {"type": "change", "at": "...", "kicker": "...", "unit": "...", "before": {"label": "...", "value": 1.2}, "after": {"label": "...", "value": 1.5}},
 "rules": [
  "\"change\": one value then and now, both stated in the article, one unit, no computed difference;"
 ],
 "example": {"type": "change", "at": "ფასი გაიზარდა", "kicker": "ცვლილება", "unit": "ლარი", "before": {"label": "2024", "value": 1.2}, "after": {"label": "2025", "value": 1.5}}
}
