{
 "type": "pair",
 "order": 100,
 "what": "two sides side by side: items [{title, sub}] x2; between: a short word on the divider",
 "use_when": "two sides: two parties, two offers, before and after in words",
 "avoid_when": "more than two sides",
 "pairs_with": ["quote", "compare"],
 "slots": {
  "items": {"kind": "list", "count": [2, 2], "of": {"title": {"kind": "text", "max": 24, "required": true}, "sub": {"kind": "text", "max": 48}}, "required": true},
  "kicker": {"kind": "text", "max": 24},
  "headline": {"kind": "text", "max": 40},
  "between": {"kind": "text", "max": 12}
 },
 "families_deny": [],
 "min_seconds": 2.8,
 "min_words": 6,
 "em": {"fields": ["items.title", "items.sub", "headline"], "kinds": ["underline", "box"]},
 "schema": {"type": "pair", "at": "...", "kicker": "...", "items": [{"title": "...", "sub": "..."}, {"title": "...", "sub": "..."}], "between": "..."},
 "rules": [
  "\"pair\": two sides of the story;"
 ],
 "example": {"type": "pair", "at": "ორი მხარე", "kicker": "ორი მხარე", "between": "და", "items": [{"title": "მერია", "sub": "სამუშაოები ორ კვირაში"}, {"title": "მცხოვრებები", "sub": "გაზის გარეშე"}]}
}
